/* Deep Transcribe timeline and analytics styles.
   Everything injected by the dt_* modules carries .dt-ui so one print rule
   can hide the interactive chrome and keep the printed PDF unchanged. */

:root {
  /* Speaker palette: 8 hues. --dt-sp-N is the text-safe variant (WCAG AA on
     the theme background); --dt-sp-N-vivid is the brighter fill variant used
     for bands, bars, and markers in both themes. */
  --dt-sp-0: #0b7285;
  --dt-sp-1: #9a5b00;
  --dt-sp-2: #6741d9;
  --dt-sp-3: #c2255c;
  --dt-sp-4: #28803a;
  --dt-sp-5: #1971c2;
  --dt-sp-6: #c23d08;
  --dt-sp-7: #495d92;
  --dt-sp-0-vivid: #22b8cf;
  --dt-sp-1-vivid: #f59f00;
  --dt-sp-2-vivid: #845ef7;
  --dt-sp-3-vivid: #f06595;
  --dt-sp-4-vivid: #40c057;
  --dt-sp-5-vivid: #339af0;
  --dt-sp-6-vivid: #f76707;
  --dt-sp-7-vivid: #748ffc;
  --dt-rail-width: 3.4rem;
}

[data-theme="dark"] {
  /* Same hues, lightened to stay AA against the dark background. */
  --dt-sp-0: #3bc9db;
  --dt-sp-1: #ffc078;
  --dt-sp-2: #b197fc;
  --dt-sp-3: #faa2c1;
  --dt-sp-4: #8ce99a;
  --dt-sp-5: #74c0fc;
  --dt-sp-6: #ffa94d;
  --dt-sp-7: #a5b4d4;
}

/* One class per speaker slot; components read the indirection vars. */
.dt-s0 { --dt-c: var(--dt-sp-0); --dt-cv: var(--dt-sp-0-vivid); }
.dt-s1 { --dt-c: var(--dt-sp-1); --dt-cv: var(--dt-sp-1-vivid); }
.dt-s2 { --dt-c: var(--dt-sp-2); --dt-cv: var(--dt-sp-2-vivid); }
.dt-s3 { --dt-c: var(--dt-sp-3); --dt-cv: var(--dt-sp-3-vivid); }
.dt-s4 { --dt-c: var(--dt-sp-4); --dt-cv: var(--dt-sp-4-vivid); }
.dt-s5 { --dt-c: var(--dt-sp-5); --dt-cv: var(--dt-sp-5-vivid); }
.dt-s6 { --dt-c: var(--dt-sp-6); --dt-cv: var(--dt-sp-6-vivid); }
.dt-s7 { --dt-c: var(--dt-sp-7); --dt-cv: var(--dt-sp-7-vivid); }

/* Speaker labels in the prose pick up their speaker's color. */
strong.dt-speaker-label {
  color: var(--dt-c);
}

.dt-ui {
  font-family: var(--font-sans);
  font-feature-settings: var(--font-features-sans);
}

/* ---- Shared panel treatment (matches the transcript outline: no box) ---- */

.dt-panel {
  margin: 1.5rem 0 2rem;
  padding: 1rem;
  font-size: var(--font-size-small);
}

.dt-panel-title {
  font-weight: 600;
  font-size: 1.1rem;
  margin-bottom: 0.75rem;
}

.dt-time-chip {
  font-family: var(--font-mono);
  font-size: var(--font-size-mono-tiny);
  color: var(--color-secondary);
  background: var(--color-bg-alt);
  border-radius: 0.25rem;
  padding: 0 0.3rem;
  margin-left: 0.45rem;
  cursor: pointer;
  white-space: nowrap;
}

.dt-time-chip:hover {
  color: var(--color-primary);
  background: var(--color-hover-bg);
}

/* ---- Horizontal Timeline overview panel ---- */

.dt-overview {
  display: block;
  width: 100%;
  height: auto;
}

.dt-ov-axis {
  stroke: var(--color-border-hint);
  stroke-width: 1;
}

.dt-ov-axis-label {
  font-size: 9px;
  font-family: var(--font-mono);
  fill: var(--color-tertiary);
}

.dt-ov-section {
  fill: var(--color-bg-alt);
  stroke: var(--color-hint);
  stroke-width: 1;
  cursor: pointer;
  transition: stroke 0.15s ease-in-out, fill 0.15s ease-in-out;
}

.dt-ov-section.dt-hot {
  stroke: var(--color-primary);
  stroke-width: 1.8;
  fill: var(--color-hover-bg);
}

.dt-ov-section-label {
  font-size: 9.5px;
  fill: var(--color-secondary);
  pointer-events: none;
}

.dt-ov-band {
  fill: var(--dt-cv, var(--color-hint));
  opacity: 0.9;
  cursor: pointer;
}

.dt-ov-frame {
  fill: var(--color-bg-solid);
  stroke: var(--color-hint-strong);
  stroke-width: 1;
  cursor: pointer;
}

.dt-ov-frame:hover,
.dt-ov-frame.dt-hot {
  stroke: var(--color-primary);
  stroke-width: 2;
}

.dt-ov-marker {
  stroke: var(--color-primary);
  stroke-width: 1.6;
  pointer-events: none;
}

/* ---- Vertical rail (hidden until the transcript is being read) ---- */

#dt-rail {
  position: fixed;
  top: 4.5rem;
  bottom: 3.5rem;
  right: 0.9rem;
  width: var(--dt-rail-width);
  z-index: 40;
  display: none;
  border-radius: 0.4rem;
  outline: none;
  opacity: 0;
  transform: translateX(0.6rem);
  transition: opacity 0.35s ease-in-out, transform 0.35s ease-in-out;
  pointer-events: none;
}

#dt-rail.dt-rail-visible {
  opacity: 1;
  transform: translateX(0);
  pointer-events: auto;
}

#dt-rail:focus-visible {
  box-shadow: 0 0 0 3px var(--color-primary);
}

/* Make room for the open video popover, which parks at bottom right. */
body.yt-open #dt-rail {
  bottom: min(24rem, 45vh);
}

@media (min-width: 1150px) {
  #dt-rail.dt-active {
    display: block;
  }
}

#dt-rail svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.dt-rail-track {
  fill: var(--color-hint-gentle);
}

.dt-rail-seg {
  fill: var(--dt-cv, var(--color-hint));
  opacity: 0.85;
  transition: opacity 0.15s ease-in-out;
}

#dt-rail:hover .dt-rail-seg {
  opacity: 1;
}

.dt-rail-section-tick {
  stroke: var(--color-text);
  stroke-width: 1;
  opacity: 0.55;
}

.dt-rail-frame-tick {
  fill: var(--color-bg-solid);
  stroke: var(--color-hint-strong);
  stroke-width: 1;
  cursor: pointer;
}

.dt-rail-frame-tick.dt-hot {
  stroke: var(--color-primary);
  stroke-width: 2;
  fill: var(--color-hover-bg);
}

.dt-rail-window {
  position: absolute;
  left: 0;
  width: 100%;
  background: var(--color-selection);
  opacity: 0.16;
  border-top: 1px solid var(--color-hint-strong);
  border-bottom: 1px solid var(--color-hint-strong);
  border-radius: 0.2rem;
  pointer-events: none;
}

.dt-rail-marker {
  position: absolute;
  left: -0.15rem;
  width: calc(100% + 0.3rem);
  height: 0;
  border-top: 2px solid var(--color-primary);
  pointer-events: none;
}

.dt-rail-marker::before {
  content: "";
  position: absolute;
  left: -0.45rem;
  top: -0.28rem;
  border: 0.27rem solid transparent;
  border-left-color: var(--color-primary);
}

.dt-rail-tip {
  position: fixed;
  right: calc(var(--dt-rail-width) + 1.6rem);
  max-width: 17rem;
  padding: 0.5rem 0.7rem;
  background: var(--color-tooltip-bg);
  color: #fff;
  border-radius: 0.4rem;
  font-size: var(--font-size-tiny);
  line-height: 1.35;
  pointer-events: none;
  z-index: 60;
  backdrop-filter: blur(2px);
}

.dt-rail-tip .dt-tip-head {
  display: flex;
  align-items: baseline;
  gap: 0.45rem;
  font-weight: var(--font-weight-sans-bold);
  margin-bottom: 0.15rem;
}

.dt-rail-tip .dt-tip-time {
  font-family: var(--font-mono);
  font-size: var(--font-size-mono-tiny);
  opacity: 0.85;
}

.dt-tip-dot {
  display: inline-block;
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;
  background: var(--dt-cv, var(--color-hint));
  flex: none;
  align-self: center;
}

/* ---- Speaker analytics panel ---- */

.dt-stats table {
  width: 100%;
  margin: 0;
  border: none;
  border-collapse: collapse;
  font-size: var(--font-size-smaller);
  table-layout: auto;
}

/* Neutralize the content table chrome: no cell min-widths, no header band. */
.dt-stats th,
.dt-stats td {
  min-width: 0;
  max-width: none;
  background-color: transparent;
}

.dt-stats tbody tr:nth-child(even) {
  background-color: var(--color-bg-alt);
}

.dt-stats th {
  text-align: left;
  font-size: var(--font-size-tiny);
  font-weight: var(--font-weight-sans-medium);
  color: var(--color-secondary);
  border-bottom: 1px solid var(--color-border-hint);
  padding: 0.25rem 0.9rem 0.25rem 0;
  white-space: nowrap;
}

.dt-stats th.dt-num,
.dt-stats td.dt-num {
  text-align: right;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.dt-stats td {
  padding: 0.3rem 0.9rem 0.3rem 0;
  vertical-align: baseline;
  word-break: normal;
}

.dt-stats .dt-speaker-name {
  color: var(--dt-c);
  font-weight: var(--font-weight-sans-bold);
  white-space: nowrap;
}

.dt-stats .dt-bar-cell {
  width: 22%;
  min-width: 4.5rem;
}

.dt-bar {
  height: 0.55rem;
  border-radius: 0.3rem;
  background: var(--dt-cv, var(--color-hint));
  min-width: 2px;
}

/* Talk-flow strip: the conversation's speaker sequence, left to right. */
.dt-flow {
  display: flex;
  margin-top: 0.9rem;
  height: 1.1rem;
  border-radius: 0.3rem;
  overflow: hidden;
}

.dt-flow-seg {
  background: var(--dt-cv, var(--color-hint));
  opacity: 0.9;
  cursor: pointer;
  min-width: 1px;
  transition: opacity 0.15s ease-in-out;
}

.dt-flow-seg:hover {
  opacity: 1;
}

.dt-flow-caption {
  margin-top: 0.35rem;
  color: var(--color-hint-strong);
  display: flex;
  justify-content: space-between;
  font-family: var(--font-mono);
  font-size: var(--font-size-mono-tiny);
}

/* ---- Concept views ---- */

.dt-ribbon,
.dt-graph {
  display: block;
  width: 100%;
  height: auto;
  margin: 0.5rem 0 1rem;
}

.dt-ribbon-row,
.dt-graph-node {
  cursor: pointer;
}

.dt-ribbon-label {
  text-anchor: end;
  font-size: 11px;
  fill: var(--color-text);
}

.dt-ribbon-track {
  stroke: var(--color-hint-gentle);
  stroke-width: 1;
}

.dt-ribbon-span {
  fill: var(--color-primary);
  opacity: 0.35;
}

.dt-ribbon-mention {
  fill: var(--color-primary);
  stroke: var(--color-bg-solid);
  stroke-width: 1;
}

.dt-graph-edge {
  fill: none;
  stroke: var(--color-hint);
  stroke-width: 1.2;
  opacity: 0.6;
}

.dt-graph-node rect {
  fill: var(--color-bg-alt-solid);
  stroke: var(--color-hint-strong);
  stroke-width: 1.2;
}

.dt-graph-node text {
  text-anchor: middle;
  font-size: 11px;
  fill: var(--color-text);
}

/* Kind is encoded on the node border and the definition badge. */
.dt-kind-topic rect { stroke: var(--color-primary); }
.dt-kind-entity rect { stroke: var(--dt-sp-5); }
.dt-kind-term rect { stroke: var(--dt-sp-7); }
.dt-kind-claim rect { stroke: var(--dt-sp-1); }
.dt-kind-decision rect { stroke: var(--dt-sp-4); }

.dt-selected .dt-ribbon-span,
.dt-selected.dt-graph-node rect {
  opacity: 1;
  stroke-width: 2;
}

.dt-dimmed {
  opacity: 0.35;
}

.dt-concept-defs {
  margin: 0.5rem 0 0;
}

.dt-concept-term {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  font-weight: var(--font-weight-sans-bold);
  cursor: pointer;
  margin-top: 0.5rem;
}

.dt-concept-kind {
  font-size: var(--font-size-mono-tiny);
  font-family: var(--font-mono);
  color: var(--color-hint-strong);
  border: 1px solid var(--color-border-hint);
  border-radius: 0.25rem;
  padding: 0 0.3rem;
}

.dt-concept-time {
  font-family: var(--font-mono);
  font-size: var(--font-size-mono-tiny);
  color: var(--color-tertiary);
}

.dt-concept-gloss {
  margin: 0.1rem 0 0.4rem 1.4rem;
  color: var(--color-secondary);
}

.dt-concept-research {
  margin-top: 0.2rem;
  font-size: var(--font-size-tiny);
  color: var(--color-hint-strong);
  border-left: 2px solid var(--color-border-hint);
  padding-left: 0.5rem;
}

/* Claims panel entries name their speakers in speaker colors. */
.dt-claim-speaker {
  color: var(--dt-c);
  font-weight: var(--font-weight-sans-medium);
  white-space: nowrap;
}

/* Selected concept's mentions highlighted in the prose, runtime only. */
.dt-mention {
  background: var(--color-hover-bg);
  outline: 2px solid var(--color-border-hint);
  border-radius: 0.25rem;
}

.dt-rail-concept-span {
  fill: var(--color-primary);
  opacity: 0.8;
}

/* ---- Frame captures: gutter layout and connectors ---- */

/* Applied by dt_frames only on wide viewports; cleared when narrow. */
@media (min-width: 1450px) {
  body.dt-frames-gutter .long-text {
    position: relative;
  }

  body.dt-frames-gutter .long-text img.frame-capture {
    position: absolute;
    left: calc(100% + 1.2rem);
    width: calc(50vw - 24rem - var(--dt-rail-width) - 3.6rem);
    max-width: 11rem;
    margin: 0;
    border-radius: 0.3rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
    transition: box-shadow 0.15s ease-in-out, transform 0.2s ease-in-out;
  }

  /* Hover (or rail hover) lifts a frame above overlapping neighbors; the
     .dt-raised class is kept briefly after the pointer leaves, tooltip-style,
     before the deck settles back. */
  body.dt-frames-gutter .long-text img.frame-capture.dt-raised {
    z-index: 30 !important;
    transform: scale(1.04);
  }

  body.dt-frames-gutter .long-text img.frame-capture:hover,
  body.dt-frames-gutter .long-text img.frame-capture.dt-hot {
    box-shadow: 0 0 0 2px var(--color-primary), 0 2px 8px rgba(0, 0, 0, 0.3);
  }
}

#dt-connectors {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 35;
}

.dt-connector {
  fill: none;
  stroke: var(--color-hint);
  stroke-width: 1.2;
  opacity: 0.5;
}

.dt-connector.dt-hot {
  stroke: var(--color-primary);
  stroke-width: 1.8;
  opacity: 0.95;
}

/* ---- Print and motion ---- */

@media print {
  .dt-ui,
  #dt-rail,
  #dt-connectors {
    display: none !important;
  }

  /* Frames print inline exactly as before this feature. */
  body.dt-frames-gutter .long-text img.frame-capture {
    position: static !important;
    width: auto !important;
    box-shadow: none !important;
    transform: none !important;
  }

  strong.dt-speaker-label {
    color: inherit;
  }
}

@media (prefers-reduced-motion: reduce) {
  #dt-rail,
  .dt-rail-seg,
  .dt-flow-seg,
  .dt-ov-section,
  body.dt-frames-gutter .long-text img.frame-capture {
    transition: none !important;
  }
}
