/* Deep Transcribe concept views: a swimlane ribbon of when each concept is
   discussed, a time-layered relation graph (chronology supplies the x axis;
   no force simulation), and a plain definition list that also serves print
   and screen readers. Selecting a concept highlights its mentions in the
   prose and broadcasts dt:conceptselect for the rail. */
(function () {
  "use strict";

  const SVG_NS = "http://www.w3.org/2000/svg";
  let model = null;
  let selected = null;
  let root = null;
  const rootExtras = [];
  let conceptGroups = [];

  function svgEl(name, attrs, text) {
    const el = document.createElementNS(SVG_NS, name);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
    if (text != null) el.textContent = text;
    return el;
  }

  function el(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text != null) node.textContent = text;
    return node;
  }

  function timeSpan() {
    const units = model.index.units;
    const start = units.length ? units[0].start : 0;
    return { start, length: Math.max(1, model.duration - start) };
  }

  function applySelection() {
    for (const scope of [root, ...rootExtras].filter(Boolean)) {
      scope.querySelectorAll("[data-concept]").forEach((node) => {
        node.classList.toggle("dt-selected", node.dataset.concept === selected);
        node.classList.toggle("dt-dimmed", selected != null && node.dataset.concept !== selected);
      });
    }
  }

  function select(id) {
    selected = selected === id ? null : id;
    applySelection();
    for (const unit of model.index.units) {
      if (!unit.el) continue;
      const concept = model.index.concepts.find((c) => c.id === selected);
      const hit = concept && concept.mentions.some((m) => m.key === unit.key);
      unit.el.classList.toggle("dt-mention", Boolean(hit));
    }
    document.dispatchEvent(new CustomEvent("dt:conceptselect", { detail: { id: selected } }));
  }

  /* Full-width mini timeline for one concept: track, kind-colored span, and
     mention dots that show the transcript at that moment on hover. */
  function buildConceptTrack(concept) {
    const track = el("div", "dt-concept-track");
    const duration = Math.max(1, model.duration);
    const span = el("span", "dt-track-span");
    span.style.left = `${(concept.span[0] / duration) * 100}%`;
    span.style.width = `${Math.max(0.5, ((concept.span[1] - concept.span[0]) / duration) * 100)}%`;
    track.appendChild(span);
    for (const mention of concept.mentions) {
      const dot = el("span", "dt-track-dot");
      dot.style.left = `${(mention.t / duration) * 100}%`;
      model.tooltip.attach(dot, () => {
        const unit = model.index.units.find((u) => u.key === mention.key);
        const name =
          unit && unit.speaker != null
            ? model.speakerById.get(unit.speaker)?.name || ""
            : "";
        return model.tipContent({
          speakerClass: unit && unit.speaker != null ? model.speakerClass(unit.speaker) : null,
          name,
          time: model.formatTime(mention.t),
          text: unit ? unit.excerpt : null,
        });
      });
      dot.addEventListener("click", (event) => {
        event.stopPropagation();
        model.playAt(mention.t);
      });
      track.appendChild(dot);
    }
    return track;
  }

  /* The one concept chip: kind tag, dividing bar, medium-weight value, all
     outlined in the kind's color. Used identically in the definition list,
     the Claims panel, and the graph (compact spacing there). */
  function makeConceptChip(concept) {
    const chip = el("span", `dt-concept-chip dt-kind-${concept.kind} dt-hoverable`);
    chip.dataset.concept = concept.id;
    chip.appendChild(el("span", "dt-chip-kind", concept.kind));
    chip.appendChild(el("span", "dt-chip-label", concept.label));
    chip.addEventListener("click", (event) => {
      event.stopPropagation();
      select(concept.id);
    });
    return chip;
  }

  /* Deterministic time-layered graph: the actual chip elements are positioned
     over an SVG that draws only the relation edges, so graph nodes and
     standalone chips are identical by construction. Chips are measured in the
     document, then packed into rows by first-mention time. */
  function buildGraph(concepts, width) {
    const wrap = el("div", "dt-graph");
    const edges = svgEl("svg", { class: "dt-graph-edges" });
    wrap.appendChild(edges);
    const nodes = concepts.map((concept) => {
      const chip = makeConceptChip(concept);
      chip.classList.add("dt-graph-chip");
      model.tooltip.attach(chip, () => `${concept.label} — ${concept.gloss}`);
      wrap.appendChild(chip);
      return { concept, chip };
    });
    return { wrap, edges, nodes, width };
  }

  /* The time range a set of concepts actually occupies, padded so the first and last
     chips are not flush against the edges. */
  function spanOf(concepts) {
    let first = Infinity;
    let last = -Infinity;
    for (const concept of concepts) {
      first = Math.min(first, concept.span[0]);
      last = Math.max(last, concept.span[1]);
    }
    if (!isFinite(first) || last <= first) return null;
    return { start: first, length: last - first };
  }

  function layoutGraph(graph) {
    const { wrap, edges, nodes, width } = graph;
    // A theme's graph spans the theme, not the recording. Laying a thirty-minute theme
    // out on a five-hour axis would crowd every chip into the left tenth of it.
    const { start, length } = graph.span || timeSpan();
    const rowGap = 12;
    const x = (t) => 8 + ((t - start) / length) * (width - 24);
    const rows = [];
    let chipHeight = 0;
    for (const node of nodes) {
      node.w = node.chip.offsetWidth;
      chipHeight = Math.max(chipHeight, node.chip.offsetHeight);
      node.x = Math.max(8, Math.min(x(node.concept.mentions[0].t), width - node.w - 8));
      let row = rows.findIndex((endX) => node.x > endX + 10);
      if (row === -1) {
        row = rows.length;
        rows.push(-Infinity);
      }
      node.row = row;
      rows[row] = node.x + node.w;
    }
    const rowHeight = chipHeight + rowGap;
    for (const node of nodes) {
      node.y = 6 + node.row * rowHeight;
      node.chip.style.left = `${node.x}px`;
      node.chip.style.top = `${node.y}px`;
    }
    const height = rows.length * rowHeight + 6;
    wrap.style.height = `${height}px`;
    edges.setAttribute("viewBox", `0 0 ${width} ${height}`);
    edges.style.height = `${height}px`;

    const byId = new Map(nodes.map((n) => [n.concept.id, n]));
    edges.textContent = "";
    for (const node of nodes) {
      for (const relation of node.concept.relations) {
        const target = byId.get(relation.to);
        if (!target) continue;
        const x0 = node.x + node.w / 2;
        const y0 = node.y + chipHeight / 2;
        const x1 = target.x + target.w / 2;
        const y1 = target.y + chipHeight / 2;
        const bend = (y1 - y0) * 0.3 + (y1 === y0 ? 24 : 0);
        const path = svgEl("path", {
          class: "dt-graph-edge",
          d: `M ${x0} ${y0} C ${x0} ${y0 + bend}, ${x1} ${y1 - bend}, ${x1} ${y1}`,
        });
        model.tooltip.attach(path, () =>
          `${node.concept.label} → ${relation.type} → ${target.concept.label}`
        );
        edges.appendChild(path);
      }
    }
  }

  /* Long recordings arrive already grouped: the reduce pass names a theme for each
     concept and orders them by theme, so consecutive runs of one theme are the groups.
     Below the length where a flat list is still a map, groups start collapsed — a dozen
     theme lines you can open beats twenty screens you have to scroll. Short media has no
     themes at all and renders exactly as before. */
  const FLAT_LIST_LIMIT = 24;

  function groupByTheme(concepts) {
    const groups = [];
    for (const concept of concepts) {
      const theme = concept.theme || null;
      const last = groups[groups.length - 1];
      if (last && last.theme === theme) last.concepts.push(concept);
      else groups.push({ theme, concepts: [concept] });
    }
    return groups;
  }

  function buildThemeGroup(theme, count, collapsed) {
    const group = el("div", `dt-theme-group${collapsed ? " dt-collapsed" : ""}`);
    const head = el("button", "dt-theme-head");
    head.type = "button";
    head.setAttribute("aria-expanded", collapsed ? "false" : "true");
    head.appendChild(el("span", "dt-theme-name", theme));
    head.appendChild(el("span", "dt-theme-count", String(count)));
    head.addEventListener("click", () => {
      const nowCollapsed = !group.classList.contains("dt-collapsed");
      group.classList.toggle("dt-collapsed", nowCollapsed);
      head.setAttribute("aria-expanded", nowCollapsed ? "false" : "true");
    });
    group.appendChild(head);
    const body = el("div", "dt-theme-body");
    group.appendChild(body);
    return { group, body };
  }

  function buildDefinitions(concepts) {
    const byId = new Map(concepts.map((c) => [c.id, c]));
    const list = el("div", "dt-concept-defs");
    const groups = groupByTheme(concepts);
    const themed = groups.some((g) => g.theme);
    const collapsed = themed && concepts.length > FLAT_LIST_LIMIT;
    // Built expanded even when they will end collapsed, so their graphs can be measured
    // and laid out once before anything is hidden.
    let target = list;
    let groupIndex = -1;
    conceptGroups = [];
    for (const concept of concepts) {
      // Open a new theme container whenever this concept starts the next group.
      const nextGroup = groups[groupIndex + 1];
      if (themed && nextGroup && nextGroup.concepts[0] === concept) {
        groupIndex += 1;
        if (nextGroup.theme) {
          const built = buildThemeGroup(nextGroup.theme, nextGroup.concepts.length, false);
          built.collapse = collapsed;
          built.concepts = nextGroup.concepts;
          conceptGroups.push(built);
          list.appendChild(built.group);
          target = built.body;
        } else {
          target = list;
        }
      }
      const entry = el("div", `dt-concept-entry dt-kind-${concept.kind}`);
      entry.dataset.concept = concept.id;
      const term = el("div", "dt-concept-term");
      term.appendChild(makeConceptChip(concept));
      const detail = el("div", "dt-concept-gloss", concept.gloss);
      // Print form of the edge tooltips: typed relations in words.
      if (concept.relations.length) {
        const relations = el("div", "dt-concept-relations dt-print-only");
        concept.relations.forEach((relation, i) => {
          if (i > 0) relations.appendChild(document.createTextNode(" · "));
          relations.appendChild(
            el("span", "dt-relation-type", relation.type.replace(/-/g, " "))
          );
          relations.appendChild(
            el("span", "dt-relation-target", byId.get(relation.to)?.label || relation.to)
          );
        });
        detail.appendChild(relations);
      }
      if (concept.research && concept.research.summary) {
        const research = el("div", "dt-concept-research", concept.research.summary);
        for (const source of concept.research.sources || []) {
          const a = document.createElement("a");
          a.href = source;
          a.textContent = new URL(source).hostname;
          a.target = "_blank";
          a.rel = "noopener";
          research.append(" ", a);
        }
        detail.appendChild(research);
      }
      // Reading order: centered chip, its timeline right below, then the gloss.
      // The track's dots carry the mention positions, in print as on screen.
      entry.append(term, buildConceptTrack(concept), detail);
      target.appendChild(entry);
    }
    return list;
  }

  /* Claims and decisions get their own focused panel, with each entry
     attributed to the speakers who made it. */
  function buildClaims(concepts) {
    const claims = concepts.filter((c) => c.kind === "claim");
    if (!claims.length) return null;
    const panel = model.makePanel("Claims");
    const list = el("div", "dt-concept-defs");
    for (const concept of claims) {
      const entry = el("div", `dt-concept-entry dt-kind-${concept.kind}`);
      const term = el("div", "dt-concept-term");
      term.appendChild(makeConceptChip(concept));
      const chip = el("span", "dt-timestamp dt-time-chip", model.formatTime(concept.span[0]));
      chip.addEventListener("click", (event) => {
        event.stopPropagation();
        model.playAt(concept.span[0]);
      });
      term.appendChild(chip);
      // Who made the claim, stated plainly on its own line.
      const madeBy = el("div", "dt-claim-made-by");
      madeBy.appendChild(el("span", "dt-claim-made-by-label", "Made by: "));
      const named = concept.speakers
        .map((id) => ({ id, name: model.speakerById.get(id)?.name }))
        .filter((s) => s.name);
      named.forEach((speaker, i) => {
        if (i > 0) madeBy.appendChild(document.createTextNode(", "));
        madeBy.appendChild(
          el("span", `dt-claim-speaker ${model.speakerClass(speaker.id)}`, speaker.name)
        );
      });
      entry.append(term, madeBy, el("div", "dt-concept-gloss", concept.gloss));
      list.appendChild(entry);
    }
    panel.appendChild(list);
    return panel;
  }

  /* The outline names every section — 172 of them on a five-hour recording, which is a
     wall rather than a map. Group it under the themes the reduce pass already found, so
     the outline and the concept map agree on the shape of the conversation instead of
     describing it two different ways. Short media has no themes and is left alone. */
  const OUTLINE_FLAT_LIMIT = 30;

  function themeSpans(concepts) {
    const spans = [];
    for (const concept of concepts) {
      if (!concept.theme) continue;
      const last = spans[spans.length - 1];
      if (last && last.label === concept.theme) last.end = Math.max(last.end, concept.span[1]);
      else spans.push({ label: concept.theme, start: concept.span[0], end: concept.span[1] });
    }
    return spans;
  }

  function groupOutlineByTheme(concepts) {
    const outline = document.querySelector(".transcript-outline");
    if (!outline) return;
    const list = outline.querySelector("ul, ol");
    if (!list) return;
    const items = [...list.children].filter((el) => el.tagName === "LI");
    if (items.length <= OUTLINE_FLAT_LIMIT) return;
    const spans = themeSpans(concepts);
    if (spans.length < 2) return;

    // An item's time comes from the chip the timeline cross-reference stamped on it.
    // An item with no chip belongs with whatever came before it.
    let clock = 0;
    const placed = items.map((li) => {
      const chip = li.querySelector(".dt-time-chip[data-t]");
      if (chip) clock = parseFloat(chip.dataset.t);
      let index = spans.findIndex((s) => clock >= s.start && clock <= s.end);
      if (index < 0) {
        index = 0;
        for (let i = 0; i < spans.length; i += 1) if (spans[i].start <= clock) index = i;
      }
      return { li, index };
    });

    const groups = el("div", "dt-outline-groups");
    let current = null;
    let currentIndex = -1;
    for (const { li, index } of placed) {
      if (index !== currentIndex) {
        currentIndex = index;
        const built = buildThemeGroup(spans[index].label, 0, true);
        groups.appendChild(built.group);
        current = built;
      }
      const inner = el("ul", null);
      inner.appendChild(li);
      current.body.appendChild(inner);
      const count = current.group.querySelector(".dt-theme-count");
      count.textContent = String(current.body.querySelectorAll(":scope > ul > li").length);
    }
    list.replaceWith(groups);
  }

  function init(event) {
    model = event.detail.model;
    const concepts = model.index.concepts;
    if (!concepts || !concepts.length) return;

    groupOutlineByTheme(concepts);

    if (model.elements.has("concepts")) {
      root = model.makePanel("Concepts");
      root.classList.add("dt-concepts");
      const charts = document.createElement("div");
      root.appendChild(charts);
      root.appendChild(buildDefinitions(concepts));
      model.panels.bottom.appendChild(root);

      // The graph positions real chips absolutely, so its layout is width
      // bound. Rather than depend on print events (headless printing fires
      // none), both layouts are built up front — one at the panel's width,
      // one at --dt-print-width — and CSS shows whichever medium applies.
      const printWidth =
        parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue("--dt-print-width")
        ) || 660;
      const printHost = el("div", "dt-print-host");
      printHost.style.width = `${printWidth}px`;
      root.insertBefore(printHost, charts.nextSibling);
      const printGraph = buildGraph(concepts, printWidth);
      printGraph.wrap.classList.add("dt-graph-print");
      printHost.appendChild(printGraph.wrap);

      // A time-layered graph of a hundred chips is not a graph anyone can read, and it
      // is what is left of the Concepts panel's height once the list is grouped. When
      // there are themes, each one gets its own graph of a handful of chips inside its
      // group instead of one graph of everything.
      const perTheme = conceptGroups.length > 1 && concepts.length > FLAT_LIST_LIMIT;

      let chartWidth = 0;
      const renderCharts = () => {
        const width = Math.floor(charts.getBoundingClientRect().width);
        if (!width || width === chartWidth) return;
        chartWidth = width;
        charts.textContent = "";
        if (!perTheme) {
          const graph = buildGraph(concepts, width);
          graph.wrap.classList.add("dt-graph-screen");
          charts.appendChild(graph.wrap);
          layoutGraph(graph);
        }
        layoutGraph(printGraph);
        applySelection();
      };
      new ResizeObserver(renderCharts).observe(charts);
      renderCharts();

      if (perTheme) {
        // Lay out while the groups are still expanded, then collapse: a hidden element
        // measures as zero and the layout depends on measured chip widths.
        for (const group of conceptGroups) {
          try {
            const width = Math.floor(group.body.getBoundingClientRect().width);
            if (!width) continue;
            const graph = buildGraph(group.concepts, width);
            graph.span = spanOf(group.concepts);
            graph.wrap.classList.add("dt-graph-screen", "dt-theme-graph");
            group.body.prepend(graph.wrap);
            layoutGraph(graph);
            group.graph = graph;
          } catch (error) {
            // A graph that will not lay out is worth losing; the list is not.
            if (group.graph && group.graph.wrap) group.graph.wrap.remove();
          }
        }
        applySelection();
      }
      for (const group of conceptGroups) {
        if (group.collapse) {
          group.group.classList.add("dt-collapsed");
          group.group.querySelector(".dt-theme-head").setAttribute("aria-expanded", "false");
        }
      }
    }

    if (model.elements.has("claims")) {
      const claimsPanel = buildClaims(concepts);
      if (claimsPanel) {
        model.panels.bottom.appendChild(claimsPanel);
        rootExtras.push(claimsPanel);
      }
    }
  }

  document.addEventListener("dt:ready", init);
})();
