/* Deep Transcribe concept views: a swimlane ribbon of when each concept is
   discussed, a time-layered relation graph (chronology supplies the x axis;
   no force simulation), and a plain definition list that also serves print
   and screen readers. Selecting a concept highlights its mentions in the
   prose and broadcasts dt:conceptselect for the rail. */
(function () {
  "use strict";

  const SVG_NS = "http://www.w3.org/2000/svg";
  let model = null;
  let selected = null;
  let root = null;
  const rootExtras = [];

  function svgEl(name, attrs, text) {
    const el = document.createElementNS(SVG_NS, name);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
    if (text != null) el.textContent = text;
    return el;
  }

  function el(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text != null) node.textContent = text;
    return node;
  }

  function timeSpan() {
    const units = model.index.units;
    const start = units.length ? units[0].start : 0;
    return { start, length: Math.max(1, model.duration - start) };
  }

  function applySelection() {
    for (const scope of [root, ...rootExtras]) {
      scope.querySelectorAll("[data-concept]").forEach((node) => {
        node.classList.toggle("dt-selected", node.dataset.concept === selected);
        node.classList.toggle("dt-dimmed", selected != null && node.dataset.concept !== selected);
      });
    }
  }

  function select(id) {
    selected = selected === id ? null : id;
    applySelection();
    for (const unit of model.index.units) {
      if (!unit.el) continue;
      const concept = model.index.concepts.find((c) => c.id === selected);
      const hit = concept && concept.mentions.some((m) => m.key === unit.key);
      unit.el.classList.toggle("dt-mention", Boolean(hit));
    }
    document.dispatchEvent(new CustomEvent("dt:conceptselect", { detail: { id: selected } }));
  }

  /* Tooltip for one mention: who is speaking there and what they say. */
  function mentionTipContent(mention) {
    const unit = model.index.units.find((u) => u.key === mention.key);
    const content = el("div", "");
    const head = el("div", "dt-tip-head");
    if (unit && unit.speaker != null) {
      head.appendChild(el("span", `dt-tip-dot ${model.speakerClass(unit.speaker)}`));
      head.appendChild(
        document.createTextNode(model.speakerById.get(unit.speaker)?.name || "")
      );
    }
    const time = el("span", "dt-tip-time", model.formatTime(mention.t));
    head.appendChild(time);
    content.appendChild(head);
    if (unit) {
      const text = el("div", "dt-tip-text");
      if (unit.speaker != null) {
        const label = el(
          "strong",
          `dt-speaker-label ${model.speakerClass(unit.speaker)}`,
          `${model.speakerById.get(unit.speaker)?.name || ""}: `
        );
        text.appendChild(label);
      }
      text.appendChild(document.createTextNode(unit.excerpt));
      content.appendChild(text);
    }
    return content;
  }

  /* Full-width mini timeline for one concept: track, kind-colored span, and
     mention dots that show the transcript at that moment on hover. */
  function buildConceptTrack(concept) {
    const track = el("div", "dt-concept-track");
    const duration = Math.max(1, model.duration);
    const span = el("span", "dt-track-span");
    span.style.left = `${(concept.span[0] / duration) * 100}%`;
    span.style.width = `${Math.max(0.5, ((concept.span[1] - concept.span[0]) / duration) * 100)}%`;
    track.appendChild(span);
    for (const mention of concept.mentions) {
      const dot = el("span", "dt-track-dot");
      dot.style.left = `${(mention.t / duration) * 100}%`;
      model.tooltip.attach(dot, () => mentionTipContent(mention));
      dot.addEventListener("click", (event) => {
        event.stopPropagation();
        model.playAt(mention.t);
      });
      track.appendChild(dot);
    }
    return track;
  }

  /* The one concept chip: kind tag, dividing bar, medium-weight value, all
     outlined in the kind's color. Used identically in the definition list,
     the Claims panel, and the graph (compact spacing there). */
  function makeConceptChip(concept) {
    const chip = el("span", `dt-concept-chip dt-kind-${concept.kind}`);
    chip.dataset.concept = concept.id;
    chip.appendChild(el("span", "dt-chip-kind", concept.kind));
    chip.appendChild(el("span", "dt-chip-label", concept.label));
    chip.addEventListener("click", (event) => {
      event.stopPropagation();
      select(concept.id);
    });
    return chip;
  }

  /* Deterministic time-layered graph: the actual chip elements are positioned
     over an SVG that draws only the relation edges, so graph nodes and
     standalone chips are identical by construction. Chips are measured in the
     document, then packed into rows by first-mention time. */
  function buildGraph(concepts, width) {
    const wrap = el("div", "dt-graph");
    const edges = svgEl("svg", { class: "dt-graph-edges" });
    wrap.appendChild(edges);
    const nodes = concepts.map((concept) => {
      const chip = makeConceptChip(concept);
      chip.classList.add("dt-graph-chip");
      model.tooltip.attach(chip, () => `${concept.label} — ${concept.gloss}`);
      wrap.appendChild(chip);
      return { concept, chip };
    });
    return { wrap, edges, nodes, width };
  }

  function layoutGraph(graph) {
    const { wrap, edges, nodes, width } = graph;
    const { start, length } = timeSpan();
    const rowGap = 12;
    const x = (t) => 8 + ((t - start) / length) * (width - 24);
    const rows = [];
    let chipHeight = 0;
    for (const node of nodes) {
      node.w = node.chip.offsetWidth;
      chipHeight = Math.max(chipHeight, node.chip.offsetHeight);
      node.x = Math.max(8, Math.min(x(node.concept.mentions[0].t), width - node.w - 8));
      let row = rows.findIndex((endX) => node.x > endX + 10);
      if (row === -1) {
        row = rows.length;
        rows.push(-Infinity);
      }
      node.row = row;
      rows[row] = node.x + node.w;
    }
    const rowHeight = chipHeight + rowGap;
    for (const node of nodes) {
      node.y = 6 + node.row * rowHeight;
      node.chip.style.left = `${node.x}px`;
      node.chip.style.top = `${node.y}px`;
    }
    const height = rows.length * rowHeight + 6;
    wrap.style.height = `${height}px`;
    edges.setAttribute("viewBox", `0 0 ${width} ${height}`);
    edges.style.height = `${height}px`;

    const byId = new Map(nodes.map((n) => [n.concept.id, n]));
    edges.textContent = "";
    for (const node of nodes) {
      for (const relation of node.concept.relations) {
        const target = byId.get(relation.to);
        if (!target) continue;
        const x0 = node.x + node.w / 2;
        const y0 = node.y + chipHeight / 2;
        const x1 = target.x + target.w / 2;
        const y1 = target.y + chipHeight / 2;
        const bend = (y1 - y0) * 0.3 + (y1 === y0 ? 24 : 0);
        const path = svgEl("path", {
          class: "dt-graph-edge",
          d: `M ${x0} ${y0} C ${x0} ${y0 + bend}, ${x1} ${y1 - bend}, ${x1} ${y1}`,
        });
        model.tooltip.attach(path, () =>
          `${node.concept.label} → ${relation.type} → ${target.concept.label}`
        );
        edges.appendChild(path);
      }
    }
  }

  function buildDefinitions(concepts) {
    const list = el("div", "dt-concept-defs");
    for (const concept of concepts) {
      const entry = el("div", `dt-concept-entry dt-kind-${concept.kind}`);
      entry.dataset.concept = concept.id;
      entry.appendChild(buildConceptTrack(concept));
      const term = el("div", "dt-concept-term");
      term.appendChild(makeConceptChip(concept));
      term.appendChild(el("span", "dt-timestamp", model.formatTime(concept.span[0])));
      const detail = el("div", "dt-concept-gloss", concept.gloss);
      if (concept.research && concept.research.summary) {
        const research = el("div", "dt-concept-research", concept.research.summary);
        for (const source of concept.research.sources || []) {
          const a = document.createElement("a");
          a.href = source;
          a.textContent = new URL(source).hostname;
          a.target = "_blank";
          a.rel = "noopener";
          research.append(" ", a);
        }
        detail.appendChild(research);
      }
      entry.append(term, detail);
      list.appendChild(entry);
    }
    return list;
  }

  /* Claims and decisions get their own focused panel, with each entry
     attributed to the speakers who made it. */
  function buildClaims(concepts) {
    const claims = concepts.filter((c) => c.kind === "claim");
    if (!claims.length) return null;
    const panel = model.makePanel("Claims");
    const list = el("dl", "dt-concept-defs");
    for (const concept of claims) {
      const term = el("dt", "dt-concept-term");
      term.appendChild(makeConceptChip(concept));
      for (const speakerId of concept.speakers) {
        const name = model.speakerById.get(speakerId)?.name;
        if (name) {
          term.appendChild(
            el("span", `dt-claim-speaker ${model.speakerClass(speakerId)}`, name)
          );
        }
      }
      const chip = el("span", "dt-timestamp dt-time-chip", model.formatTime(concept.span[0]));
      chip.addEventListener("click", (event) => {
        event.stopPropagation();
        model.playAt(concept.span[0]);
      });
      term.appendChild(chip);
      list.append(term, el("dd", "dt-concept-gloss", concept.gloss));
    }
    panel.appendChild(list);
    return panel;
  }

  function init(event) {
    model = event.detail.model;
    const concepts = model.index.concepts;
    if (!concepts || !concepts.length) return;

    root = model.makePanel("Concepts");
    root.classList.add("dt-concepts");
    const charts = document.createElement("div");
    root.appendChild(charts);
    root.appendChild(buildDefinitions(concepts));
    model.panels.bottom.appendChild(root);

    // Charts render at the panel's real pixel width, like the Timeline, so
    // their type sits on the design system's own sizes.
    let chartWidth = 0;
    const renderCharts = () => {
      const width = Math.floor(charts.getBoundingClientRect().width);
      if (!width || width === chartWidth) return;
      chartWidth = width;
      charts.textContent = "";
      const graph = buildGraph(concepts, width);
      charts.appendChild(graph.wrap);
      layoutGraph(graph);
      applySelection();
    };
    new ResizeObserver(renderCharts).observe(charts);
    renderCharts();

    const claimsPanel = buildClaims(concepts);
    if (claimsPanel) {
      // Claims select through the shared handler, so keep them inside root's
      // event scope by tracking selection classes on both panels.
      model.panels.bottom.appendChild(claimsPanel);
      claimsPanel.querySelectorAll("[data-concept]").forEach(() => {});
      rootExtras.push(claimsPanel);
    }
  }

  document.addEventListener("dt:ready", init);
})();
