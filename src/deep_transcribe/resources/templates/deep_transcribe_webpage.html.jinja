{% extends "youtube_webpage.html.jinja" %}

{% block custom_styles %}
{{ super() }}
<style>
{% include "components/dt_tokens.css.jinja" %}
{% include "components/dt_viz.css.jinja" %}
/* The reading column sits left, so the player takes the free upper right. */
.yt-popover {
  top: 4.5rem !important;
  bottom: auto !important;
  right: 1rem !important;
  left: auto !important;
}

.timestamp-link {
  background-color: transparent !important;
  color: var(--color-tertiary) !important;
  font-size: var(--font-size-tiny);
  font-weight: normal;
  border-radius: 0.2rem;
  transition: background-color 0.12s ease-in-out, color 0.12s ease-in-out;
}

/* Timestamps never underline, hovered or not, anywhere in the document. */
.timestamp-link a,
.timestamp-link a:hover,
.timestamp-link a:visited {
  text-decoration: none !important;
}

/* Same hover treatment as the injected timestamp chips. */
.timestamp-link:hover {
  background-color: var(--color-hover-bg) !important;
  color: var(--color-primary) !important;
}

.timestamp-link:hover a {
  color: var(--color-primary);
  text-decoration: none;
}

.timestamp-link a,
.timestamp-link a:visited {
  color: inherit !important;
  text-decoration: none;
}

.timestamp-link a:hover {
  text-decoration: underline;
}

/* Source thumbnails arrive at their natural size, which is wide enough to push the
   synopsis off the first page. Cap it so the transcript still leads the document. */
.thumbnail {
  display: block;
  margin-inline: auto;
  max-width: 45%;
}

@media print {
  .theme-toggle {
    display: none !important;
  }

  .timestamp-link,
  .timestamp-link:hover {
    color: var(--color-tertiary) !important;
    font-family: var(--font-sans) !important;
    font-size: 9pt;
  }

  .long-text p:has(> .frame-capture) {
    break-inside: avoid;
  }

  @page {
    /* Chrome ignores `margin` on page margin boxes, so `vertical-align` plus a tall
       line box is the only way to place the footer. Both boxes take the same font
       size so the note and the page number share one baseline. */
    @bottom-left {
      content: "Transcribed by github.com/jlevy/deep-transcribe";
      font-family: var(--font-sans) !important;
      font-size: 9pt;
      vertical-align: bottom;
      line-height: 2.6;
    }

    @bottom-right {
      font-size: 9pt;
      vertical-align: bottom;
      line-height: 2.6;
    }
  }
}
</style>
{% endblock custom_styles %}

{% block scripts_extra %}
{{ super() }}
<script>
{% include "components/dt_core.js.jinja" %}
{% include "components/dt_tip.js.jinja" %}
{% include "components/dt_timeline.js.jinja" %}
{% include "components/dt_rail.js.jinja" %}
{% include "components/dt_stats.js.jinja" %}
{% include "components/dt_frames.js.jinja" %}
{% include "components/dt_concepts.js.jinja" %}
</script>
{% endblock scripts_extra %}
